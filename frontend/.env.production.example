# ==============================================================================
# AgentMesh / AgentGuild - Production Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=production
MOCK_MODE=false
PORT=3000

# ------------------------------------------------------------------------------
# 2. CLIENT-EXPOSED PUBLIC VARIABLES (Safe for browser bundle)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MST_RPC_URL=https://testnetrpc.mstblockchain.com
NEXT_PUBLIC_MST_EXPLORER_URL=https://testnet.mstscan.com
NEXT_PUBLIC_MST_PLATFORM_WALLET=0x6001712aE72d24BAbC386866D035B6D55331E634
NEXT_PUBLIC_MST_ESCROW_CONTRACT=0xB802751b3a75eAB0C5cB1f9da8B684eC9308196E
NEXT_PUBLIC_MST_SETTLEMENT_MODE=escrow

# ------------------------------------------------------------------------------
# 3. SERVER-SIDE MST BLOCKCHAIN CONFIGURATION (Never exposed to browser)
# ------------------------------------------------------------------------------
MST_NETWORK=testnet
MST_CHAIN_ID=91562037
MST_RPC_URL=https://testnetrpc.mstblockchain.com
MST_EXPLORER_URL=https://testnet.mstscan.com
MST_ESCROW_CONTRACT=0xB802751b3a75eAB0C5cB1f9da8B684eC9308196E
MST_SETTLEMENT_MODE=escrow

# Optional: Server platform signer private key for automated backend settlement.
# If omitted, manual transaction broadcast via client wallet signature is used.
# MST_PLATFORM_PRIVATE_KEY=0x...

# ------------------------------------------------------------------------------
# 4. LLM API KEYS (Server-Only Secrets)
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_...
GROQ_API_KEY_1=gsk_...
# Optional fallback provider
# OPENROUTER_API_KEY=sk-or-v1-...

# ------------------------------------------------------------------------------
# 5. SERVERLESS STORAGE (Required only if deploying on Vercel)
# ------------------------------------------------------------------------------
# Vercel Blob read/write token for SQLite database persistence across lambdas
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

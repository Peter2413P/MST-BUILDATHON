# AgentGuild Environment Configuration Example
# Copy to .env.local for local development

# Database / Storage (Optional Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# LLM Providers (Groq / Anthropic / OpenAI / Mock)
GROQ_API_KEY=
MOCK_MODE=false

# External Design / Build / Debug Providers (Optional - falls back to built-in LLM adapter)
DESIGN_PROVIDER=agentguild_design_engine
DESIGN_API_URL=
DESIGN_API_KEY=
BUILD_API_KEY=
DEBUG_API_KEY=

# Blockchain & MST Network
MST_RPC_URL=https://testnetrpc.mstblockchain.com
MST_CHAIN_ID=91562037
MST_EXPLORER_URL=https://testnet.mstscan.com
MST_ESCROW_PRIVATE_KEY=

# Shopping Agent External Product API (Optional - uses Verified Real Catalog Provider by default)
PRODUCT_API_URL=
PRODUCT_API_KEY=
PRODUCT_API_NAME=External Retailer API

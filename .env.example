# ==========================================
# AgentMesh / AgentGuild Configuration
# ==========================================

# Set to true to skip all LLM calls and return instant responses for UI/flow testing.
MOCK_MODE=false

# Groq LLM API Key (console.groq.com)
GROQ_API_KEY_1=gsk_...
GROQ_API_KEY_2=gsk_...
GROQ_API_KEY_3=gsk_...
GROQ_API_KEY_4=gsk_...
GROQ_API_KEY_5=gsk_...
GROQ_API_KEY=gsk_...

# ==========================================
# MST Blockchain (Testnet)
# ==========================================
MST_NETWORK=testnet
MST_CHAIN_ID=91562037
MST_RPC_URL=https://testnetrpc.mstblockchain.com
MST_EXPLORER_URL=https://testnet.mstscan.com
MST_FAUCET_URL=https://faucet.masterstroke.academy

# Public Next.js environment variables (accessible in browser)
NEXT_PUBLIC_MST_RPC_URL=https://testnetrpc.mstblockchain.com
NEXT_PUBLIC_MST_EXPLORER_URL=https://testnet.mstscan.com
NEXT_PUBLIC_MST_PLATFORM_WALLET=0x6001712aE72d24BAbC386866D035B6D55331E634

# Server-side platform private key for on-chain split settlements (optional)
# MST_PLATFORM_PRIVATE_KEY=0x...

# Server ports
PORT=4000
FRONTEND_URL=http://localhost:3000
ORCHESTRATOR_URL=http://localhost:4000

# Shopping Agent External Product API (Optional - uses Verified Real Catalog Provider by default)
PRODUCT_API_URL=
PRODUCT_API_KEY=
PRODUCT_API_NAME=External Retailer API
